# Anthropic — the recommended provider for exceptional legal writing.
# Tier-leading register on tribunal-bound + high-risk letters.
ANTHROPIC_API_KEY=
# Optional explicit model — overridden per-request via Settings → Generation model.
# Options: claude-opus-4-7 (best, slow), claude-sonnet-4-6 (recommended default),
#          claude-haiku-4-5 (fast + cheap)
LLM_MODEL=claude-sonnet-4-6

# ====== Auth (WorkOS AuthKit) ======
# Local dev can leave these blank. Production fails closed unless WorkOS is set,
# or VITE_ALLOW_PUBLIC_APP=true is deliberately set for a public demo.
# Get from https://dashboard.workos.com/ → API Keys & Configuration.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
VITE_WORKOS_CLIENT_ID=
# Redirect URI the WorkOS-hosted login page returns to after auth.
# In dev: http://localhost:5273/auth/callback. Add the production URI in
# Vercel env + register both URIs in the WorkOS dashboard.
WORKOS_REDIRECT_URI=
VITE_WORKOS_REDIRECT_URI=
# Self-serve sign-up / forgot-password also need URLs registered in the
# WorkOS dashboard → Authentication → Emails:
#   - Email verification URL → https://app.drafthr.io/sign-in/verify-email
#     WorkOS appends ?code=...&user_id=... — both are required by
#     /sign-in/verify-email.
#   - Password reset URL → https://app.drafthr.io/sign-in/reset-password
#     WorkOS appends ?token=... which /sign-in/reset-password consumes.
# (No new env vars; this is a dashboard-side configuration.)
# 32+ char secret used to encrypt the session cookie (iron-session). Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKOS_COOKIE_PASSWORD=
# Webhook signing secret for Directory Sync events. Copy from the WorkOS
# dashboard when you register the webhook endpoint
# (https://app.drafthr.io/api/workos/directory-webhook). The secret is shown
# ONCE on creation — save it immediately. Without it, the Directory Sync
# webhook handler fails closed (returns 503) so a misconfigured deploy can't
# be tricked into accepting unsigned events.
WORKOS_WEBHOOK_SECRET=
VITE_ALLOW_PUBLIC_APP=false
# Server-side CSRF origin allowlist for state-changing API requests.
# Comma-separated exact origins. Defaults to https://app.drafthr.io in
# production, plus localhost variants in development. Vercel preview deploys
# matching https://drafthr-*-emotiveimpact-gmailcoms-projects.vercel.app are
# allowed by api/_utils/request.ts because their full origins change per deploy.
ALLOWED_ORIGINS=

# ====== Database (Neon Postgres) — leave blank to fall back to localStorage ======
# Get from https://console.neon.tech/ — Vercel Marketplace integrates this automatically.
# DATABASE_URL = pooled (PgBouncer transaction mode) — used by serverless runtime queries
# DATABASE_URL_UNPOOLED = direct connection — used by drizzle-kit migrations (needs DDL + session features)
# The unpooled host is the pooled host with "-pooler" stripped.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Database-first workspace release flags: set client AND server together after
# reviewing/applying the complete migration chain. Do not use the old dual-write
# activation instructions as a rollback strategy.
VITE_DRAFTHR_DATABASE_WORKSPACE=true
DRAFTHR_DATABASE_WORKSPACE=true
VITE_DRAFTHR_DATABASE_DRAFTS=true
DRAFTHR_DATABASE_DRAFTS=true

# Shared request protection uses the application Postgres database in hosted
# environments. Apply migration 0026 before deploying this code. A memory
# override is accepted ONLY in non-hosted development/tests.
DRAFTHR_RATE_LIMIT_BACKEND=database
# Optional approved HTTPS alert receiver for redacted server failure events.
# Payloads contain route group/status/request ID/timing only, no HR content.
DRAFTHR_ERROR_REPORT_URL=
DRAFTHR_ERROR_REPORT_TOKEN=
# Strong secret for authenticated scheduled audit-outbox delivery. Do not expose
# this in VITE_* variables. Enable the matching schedule only on the intended host.
CRON_SECRET=

# Dual-write flag — when "true", store mutations also POST to /api/store/* (writes to Postgres).
# Default off — production stays on localStorage until you flip this on.
# Server-side gate: /api/store/* returns 503 when not "true", so a misbehaving
# client can't write past the flag even if VITE_DRAFTHR_DUAL_WRITE is forced on.
DRAFTHR_DUAL_WRITE=false
# Client-side mirror — Vite inlines this at build, so it's a build-time
# decision. When "true", store mutations enqueue a debounced POST to
# /api/store/drafts and the app-mount backfill runs once per session.
VITE_DRAFTHR_DUAL_WRITE=false
# Workspace tenant id for the audit chain (single-tenant local dev).
# Generate with: node -e "console.log(crypto.randomUUID())"
DRAFTHR_DEFAULT_TENANT_ID=

# WorkOS Audit Logs — parallel sink for the local hash-chained audit_events
# table. When "true", every audit_events insert is mirrored to WorkOS so
# tenants can stream to their SIEM. The local chain remains the source of
# truth. Per-tenant gate: only tenants with workos_org_id set are mirrored.
# See docs/audit-logs.md for the dual-chain model and field mapping.
WORKOS_AUDIT_LOGS_ENABLED=false
# Backfill historical audit_events to WorkOS. Set to an ISO timestamp before
# running `tsx scripts/backfill-workos-audit-logs.ts` (or pass --since on CLI).
WORKOS_AUDIT_LOGS_BACKFILL_FROM=
# Resend — transactional email (workspace invites, comment notifications,
# review-requested). Get from https://resend.com/api-keys
# Without this, invites still create the row + return the link, but
# don't actually email anyone (UX shows "copy link manually").
RESEND_API_KEY=

# Branded export footer ("Drafted with DraftHR · drafthr.io") on PDF/DOCX
# exports. Calendly-mechanism: every exported letter shown to a recipient
# becomes free acquisition. Default ON for free tenants; when billing
# lands, Pro/Business/Enterprise plans auto-suppress. Set explicitly to
# "false" / "0" / "off" / "no" to kill globally (e.g. for an A/B test).
VITE_DRAFTHR_EXPORT_FOOTER=true

# ====== Error tracking (Sentry) — leave blank to disable ======
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=development
VITE_SENTRY_RELEASE=

# ====== Server-side PDF (Puppeteer + Sparticuz Chromium) ======
# Public URL to a Sparticuz chromium pack tarball that matches @sparticuz/chromium-min.
# See: https://github.com/Sparticuz/chromium/releases
CHROMIUM_PACK_URL=https://github.com/Sparticuz/chromium/releases/download/v148.0.0/chromium-v148.0.0-pack.x64.tar

# ====== Export-pack signing (KMS-backed Ed25519 CMS sidecar) ======
# ARN/alias for the approved production signer. Configured signer failure blocks
# export. Unset = explicitly unsigned ZIP with SHA-256 checksums, never an
# ephemeral local-key substitute. No PAdES/trusted-timestamp/legal-validation
# claim. Distribute the trusted public key independently; see docs/signing.md.
SIGNING_KMS_KEY_ID=
# Must match the configured key's actual region.
AWS_REGION=eu-west-2
# Direct developer/test signer tooling only; HTTP export signing ignores this.
# 32-byte hex seed. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ephemeral test keys must never be presented as trusted production keys.
DRAFTHR_SIGNING_KEY_HEX=

# ====== Private file storage (Vercel Blob) ======
# Use a PRIVATE store for evidence, exports and workspace images. The server
# issues bounded upload tokens and authorizes reads; metadata/references live
# in Postgres. Database-backed workspaces must not claim success or silently
# fall back to inline browser persistence when this configuration is missing.
# Provision/verify the intended store separately before hosted acceptance.
BLOB_READ_WRITE_TOKEN=

# --- Stripe (marketplace payments) -------------------------------------------
# When unset, the marketplace is request-based (no charge) and all Stripe
# endpoints return 503 — the app is unaffected. To enable payments: set these,
# apply migration 0012, and create TWO webhook endpoints (both pointing at
# https://<your-domain>/api/marketplace/stripe-webhook) because the two events
# live in different Stripe scopes:
#   1. ACCOUNT endpoint  → checkout.session.completed  (destination charges
#      settle on the platform)                         → STRIPE_WEBHOOK_SECRET
#   2. CONNECT endpoint  → account.updated             (events on connected
#      accounts; create with connect=true)             → STRIPE_WEBHOOK_SECRET_CONNECT
# The handler verifies each delivery against whichever of the two secrets matches.
STRIPE_SECRET_KEY=sk_test_xxx                 # server-only secret — NEVER commit / expose
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx       # safe client-side (currently unused in src/)
STRIPE_WEBHOOK_SECRET=whsec_xxx               # from the ACCOUNT-scoped webhook endpoint
STRIPE_WEBHOOK_SECRET_CONNECT=whsec_xxx       # from the CONNECT-scoped webhook endpoint
STRIPE_PLATFORM_FEE_BPS=0                     # optional platform fee, basis points (1500 = 15%)
APP_BASE_URL=https://app.drafthr.io           # optional; redirect base for Checkout/Connect
