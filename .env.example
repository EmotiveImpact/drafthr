# LLM provider — "qwen" (default) or "claude"
LLM_PROVIDER=qwen

# Qwen / Alibaba DashScope (international endpoint).
# Server-side only — never expose to the browser.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# Alternative models: qwen-plus (default — free-tier friendly, 1M context), qwen-turbo (cheap),
# qwen3-max (highest quality, paid-only — disable "free tier only" in DashScope console)

# Claude (used when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# ====== Auth (Clerk) — leave blank to disable auth in dev ======
# Get from https://dashboard.clerk.com/ → API keys
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ====== Database (Neon Postgres) — leave blank to fall back to localStorage ======
# Get from https://console.neon.tech/ — Vercel Marketplace integrates this automatically.
DATABASE_URL=

# ====== Error tracking (Sentry) — leave blank to disable ======
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=development
VITE_SENTRY_RELEASE=

# ====== Server-side PDF (Puppeteer + Sparticuz Chromium) ======
# Public URL to a Sparticuz chromium pack tarball that matches @sparticuz/chromium-min.
# See: https://github.com/Sparticuz/chromium/releases
CHROMIUM_PACK_URL=https://github.com/Sparticuz/chromium/releases/download/v148.0.0/chromium-v148.0.0-pack.x64.tar
