node_modules
dist
dist-ssr
# Vendored pagedly is a real dependency and its built output MUST ship to the
# Vercel build — keep it tracked even though the global `dist` rule above would
# otherwise ignore it. (Without this the deploy fails: "Cannot find module 'pagedly'".)
!vendor/pagedly/dist/
!vendor/pagedly/dist/**
*.local

.env
.env.local
.env.*.local

# Local backups + agent artefacts (not for shared repo)
.backups
.agents
.claude

# TypeScript build cache
*.tsbuildinfo

# Editor / OS
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json
*.swp

# Logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel

# brainstorming visual companion sandbox
.superpowers/
.env.local.backup-*
.playwright-mcp/
web2/
Assets/
public/mockups/assets/
public/mockups/moneda-clone.html
