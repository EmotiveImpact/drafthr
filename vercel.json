{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/" }
  ],
  "functions": {
    "api/draft.ts": {
      "maxDuration": 60
    },
    "api/agent.ts": {
      "maxDuration": 60
    },
    "api/export/pdf.ts": {
      "maxDuration": 60
    },
    "api/me/data.ts": {
      "maxDuration": 30
    },
    "api/cron/retention-purge.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/cron/retention-purge", "schedule": "0 3 * * *" }
  ]
}
