{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/" }
  ],
  "functions": {
    "api/draft.ts": {
      "maxDuration": 60
    },
    "api/agent.ts": {
      "maxDuration": 60
    },
    "api/export/pdf.ts": {
      "maxDuration": 60
    }
  }
}
